/* Asuka white*/

// GLOBAL SETTINGS
// ------------------------------

* {
    bg:        #F5F5F5; // Suit white
    bg-alt:    #6B7280; // Steel grey
    fg:        #1C1C1C;
    accent:    #1C1C1C; // Dark charcoal
    accent2:   #C1121F; // Asuka red

    border:    #C1121F;
    selected:  #FFFFFF; // Pure white

    background-color: rgba(245,245,245,0.5);
    // when global background is set, there is no need for it in individual blocks
    // same thing for other elements
}

// MAIN WINDOW
// ------------------------------

configuration {
    show-icons: true;
    icon-theme: "Papirus";
    location: 0;
    font: "JetBrainsMono Nerd Font 50";
}

window {
    border: 3px;
    border-color: @border;
    //border-radius: 6px;
    orientation: horizontal;
    width: 440px;
}

mainbox {
    orientation: horizontal;
    children: [ listview ];
}

// ELEMENT
// ------------------------------

listview {
    background-image: url("~/Pictures/wallpapers/Eva/asuka_white_plugsuit.jpg", height);
    background-color: transparent;
    columns: 1;
    lines: 5;
    padding: 10 40;
    fixed-height: true;
    fixed-columns: true;
    fixed-lines: true;
}

element {
    text-color: @accent;
    padding: 20px;
    border-radius: 10px;
}

element.selected {
    background-color: rgba(245,245,245,0.9);
    text-color: @accent2;
    border: 3px;
    border-color: @border;
    padding: 20px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: bold;
    horizontal-align: 0.5;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 24px;
}

