/* Evangelion Unit-02 */

// GLOBAL SETTINGS
// ------------------------------

* {
    bg:        #120809;
    bg-alt:    #5A0F14; // Dark Crimson
    fg:        #F5F5F5;
    accent:    #C1121F; // Eva Red
    accent2:   #FF6A00; // Armor Orange
    border:    #C1121F;
    border2:   #5A0F14;
    selected:  #3a0f0f;

    font: "Rajdhani 30";
    background-color: rgba(28, 28, 28 ,0.85);
    // when global background is set, there is no need for it in individual blocks
    // same thing for other elements
}

// MAIN WINDOW
// ------------------------------

window {
    width: 370px;
    location: center;
    anchor: center;
    border: 3px;
    border-color: @border;
    //border-radius: 6px;
    orientation: horizontal;
}

// MAIN LAYOUT
//-------------------------------

mainbox {
    orientation: horizontal;
    children: [ listview ];
}

// ELEMENTS
// ------------------------------

listview {
    background-image: url("~/Pictures/wallpapers/Eva/asuka_shikinami.jpg", height);
    columns: 1;
    lines: 5;
    spacing: 3px;
    padding: 10 10;
    fixed-height: true;
    fixed-columns: true;
    fixed-lines: false;
}

element {
    text-color: @fg;
    padding: 20px;
    border: 2px;
    border-color: @border2;
}

element.selected {
    background-color: rgba(58, 15, 15,1.0);
    text-color: @accent2;
    border: 3px;
    border-color: @border;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: bold;
    horizontal-align: 0.45;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 24px;
}
