/* Evangelion Unit-02 */

// GLOBAL SETTINGS
// ------------------------------

* {
    bg:        #120809;
    bg-alt:    #5A0F14; // Dark Crimson
    fg:        #F5F5F5;
    accent:    #C1121F; // Eva Red
    accent2:   #FF6A00; // Armor Orange

    border:    #C1121F;
    selected:  #3a0f0f;

    background-color: @bg;
    // when global background is set, there is no need for it in individual blocks
    // same thing for other elements
}

// MAIN WINDOW
// ------------------------------

configuration {
    show-icons: true;
    icon-theme: "Papirus";
    location: 0;
    font: "JetBrainsMono Nerd Font 12";
    display-drun: "Launch:";
    border-radius: 6px;
}

window {
    //background-color: @bg;
    border: 2px;
    border-color: @border;
    border-radius: 0px;
    padding: 6px;
    orientation: vertical;
    width: 35%;
}

mainbox {
    //background-color: @bg;
    children: [inputbar, listview];
}


// INPUT BAR
// ------------------------------

inputbar {
    background-image: url("~/Pictures/wallpapers/Eva/asuka_angel.png", width);
    //background-color: @bg-alt;
    children: [ prompt, entry ];
    padding: 280 0 0;
    //border-radius: 4px;
}

prompt {
    //background-color: transparent;
    text-color: @accent;
    padding: 10 6 0 10;
    margin: 0 -2 0 0;
    font: "monospace bold 12";
}

entry {
    //background-color: transparent;
    text-color: @accent2;
    padding: 10 10 0 0;
    margin: 0 -2 0 0;
}

// ELEMENT
// ------------------------------

listview {
    background-color: transparent;
    columns: 2;
    lines: 9;
    padding: 8 0;
    fixed-height: true;
    fixed-columns: true;
    fixed-lines: true;
}

element {
    //background-color: transparent;
    text-color: @accent;
    padding: 10px;
    border-radius: 0px;
}

element.selected {
    background-color: @selected;
    text-color: @accent2;
    border: 2px;
    border-color: @border;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: bold;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 24px;
}


scrollbar {
    border:  0;
    width: 4px;
    padding: 0;
    handle-color: @bg;
}
