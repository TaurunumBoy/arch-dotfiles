# Theme: System24
# Pink accent #da2862, dark TUI aesthetic

# Main bg - deep dark
theme[main_bg]="#0a0a0a"

# Main text color
theme[main_fg]="#c0c0c0"

# Title color for boxes
theme[title]="#da2862"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#da2862"

# Background color of selected item in processes box
theme[selected_bg]="#da2862"

# Foreground color of selected item in processes box
theme[selected_fg]="#0a0a0a"

# Color of inactive/disabled text
theme[inactive_fg]="#414868"

# Color of text appearing on top of graphs
theme[graph_text]="#c0c0c0"

# Background color of the percentage meters
theme[meter_bg]="#1a1a1a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#da2862"

# Cpu box outline color
theme[cpu_box]="#414868"

# Memory/disks box outline color
theme[mem_box]="#414868"

# Net up/down box outline color
theme[net_box]="#414868"

# Processes box outline color
theme[proc_box]="#414868"

# Box divider line and small boxes line color
theme[div_line]="#414868"

# Temperature graph colors - pink gradient
theme[temp_start]="#da2862"
theme[temp_mid]="#ff6b9d"
theme[temp_end]="#ff9ebb"

# CPU graph colors - pink monochrome
theme[cpu_start]="#6b1431"
theme[cpu_mid]="#da2862"
theme[cpu_end]="#ff6b9d"

# Mem/Disk free meter
theme[free_start]="#2d4a3e"
theme[free_mid]="#4a7a66"
theme[free_end]="#6baa8c"

# Mem/Disk cached meter
theme[cached_start]="#4a3a2d"
theme[cached_mid]="#7a6a4a"
theme[cached_end]="#aa9a6b"

# Mem/Disk available meter
theme[available_start]="#2d3a4a"
theme[available_mid]="#4a6a7a"
theme[available_end]="#6b9aaa"

# Mem/Disk used meter - pink
theme[used_start]="#6b1431"
theme[used_mid]="#da2862"
theme[used_end]="#ff6b9d"

# Download graph colors - cyan
theme[download_start]="#1a4a5a"
theme[download_mid]="#3a8a9a"
theme[download_end]="#5acada"

# Upload graph colors - pink
theme[upload_start]="#6b1431"
theme[upload_mid]="#da2862"
theme[upload_end]="#ff6b9d"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#da2862"
theme[process_mid]="#8a1842"
theme[process_end]="#414868"
